# Copy this file to .env and fill in your own values. Never commit .env.
GROQ_API_KEY=
# Any Groq chat model that supports JSON mode.
GROQ_MODEL=openai/gpt-oss-120b
PORT=3000
# Milliseconds before a Groq request is abandoned and the app is told AI is unavailable.
GROQ_TIMEOUT_MS=12000
# low | medium | high — only used by reasoning models.
GROQ_REASONING_EFFORT=low

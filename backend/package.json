{
  "name": "rooster-backend",
  "version": "1.0.0",
  "private": true,
  "description": "ROOSTER assistant backend: turns user speech into validated, structured intents via Groq. Never performs device actions.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "zod": "^3.25.76",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.11",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
